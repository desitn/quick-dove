{
  "name": "quick-dove",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.2.8",
  "publisher": "destin-zhang",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#ffffff",
    "theme": "light"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/desitn/quick-dove"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "build": "powershell.exe -ExecutionPolicy Bypass -File build.ps1",
    "build:vsix": "vsce package",
    "build:dove": "cd dove && npm run build:exe"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "iconv-lite": "^0.6.3",
    "ini": "^6.0.0",
    "serialport": "^13.0.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "firmware-explorer",
          "title": "%extension.displayName%",
          "icon": "images/icon-quick.svg"
        }
      ]
    },
    "views": {
      "firmware-explorer": [
        {
          "id": "firmware-explorer",
          "name": "%view.firmwareList%",
          "icon": "$(list-tree)",
          "contextualTitle": "Quick Dove"
        },
        {
          "id": "firmware-devices",
          "name": "%view.deviceList%",
          "icon": "$(list-tree)",
          "contextualTitle": "Quick Dove"
        },
        {
          "id": "firmware-tools",
          "name": "%view.portableTools%",
          "icon": "$(tools)",
          "contextualTitle": "Quick Dove"
        },
        {
          "id": "firmware-settings",
          "name": "%view.settings%",
          "icon": "$(gear)",
          "contextualTitle": "Quick Dove"
        }
      ]
    },
    "commands": [
      {
        "command": "firmwareDownloader.download",
        "title": "%command.download%",
        "icon": "$(arrow-circle-down)"
      },
      {
        "command": "firmwareDownloader.build",
        "title": "%command.build%",
        "icon": "$(coffee)"
      },
      {
        "command": "firmwareDownloader.refresh",
        "title": "%command.refresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "firmwareDownloader.find",
        "title": "%command.find%",
        "icon": "$(search)"
      },
      {
        "command": "firmwareDownloader.clear",
        "title": "%command.clear%",
        "icon": "$(clear-all)"
      },
      {
        "command": "firmwareDownloader.devices_refresh",
        "title": "%command.devicesRefresh%",
        "icon": "$(refresh)"
      },
      {
        "command": "firmwareDownloader.addBuildCommand",
        "title": "%command.addBuildCommand%",
        "icon": "$(add)"
      },
      {
        "command": "firmwareDownloader.selectBuildCommand",
        "title": "%command.selectBuildCommand%",
        "icon": "$(check)"
      },
      {
        "command": "firmwareDownloader.configBuildCommand",
        "title": "%command.configBuildCommand%",
        "icon": "$(list-unordered)"
      },
      {
        "command": "firmwareDownloader.showWelcome",
        "title": "%command.showWelcome%",
        "icon": "$(home)"
      },
      {
        "command": "firmwareDownloader.showSetupWizard",
        "title": "%command.showSetupWizard%",
        "icon": "$(wand)"
      },
      {
        "command": "firmwareDownloader.showSearch",
        "title": "%command.showSearch%",
        "icon": "$(search)"
      },
      {
        "command": "firmwareDownloader.searchWithEverything",
        "title": "%command.searchWithEverything%",
        "icon": "$(search)"
      },
      {
        "command": "firmwareDownloader.openLogViewer",
        "title": "%command.openLogViewer%",
        "icon": "$(file-text)"
      },
      {
        "command": "firmwareDownloader.toggleCppDefine",
        "title": "%command.toggleCppDefine%",
        "icon": "$(symbol-constant)"
      },
      {
        "command": "firmwareDownloader.openCppDefineSettings",
        "title": "%command.openCppDefineSettings%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "firmwareDownloader.openSerial",
        "title": "%command.openSerial%",
        "icon": "$(plug)"
      },
      {
        "command": "hermesRemote.addFileToContext",
        "title": "%command.addFileToContext%",
        "category": "Hermes Remote"
      },
      {
        "command": "hermesRemote.sendSelectionToContext",
        "title": "%command.sendSelectionToContext%",
        "category": "Hermes Remote"
      },
      {
        "command": "hermesRemote.setAsHermesTerminal",
        "title": "%command.setAsHermesTerminal%",
        "category": "Hermes Remote"
      },
      {
        "command": "hermesRemote.selectTerminal",
        "title": "%command.selectTerminal%",
        "category": "Hermes Remote"
      },
      {
        "command": "hermesRemote.addWorkspaceToContext",
        "title": "%command.addWorkspaceToContext%",
        "category": "Hermes Remote"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "firmwareDownloader.refresh",
          "when": "view == firmware-explorer",
          "group": "navigation"
        },
        {
          "command": "firmwareDownloader.find",
          "when": "view == firmware-explorer",
          "group": "navigation"
        },
        {
          "command": "firmwareDownloader.clear",
          "when": "view == firmware-explorer",
          "group": "navigation"
        },
        {
          "command": "firmwareDownloader.devices_refresh",
          "when": "view == firmware-devices",
          "group": "navigation"
        },
        {
          "command": "firmwareDownloader.showSearch",
          "when": "view == firmware-tools",
          "group": "navigation"
        },
        {
          "command": "firmwareDownloader.openLogViewer",
          "when": "view == firmware-tools",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "firmwareDownloader.download",
          "when": "view == firmware-explorer && viewItem == firmware-file"
        },
        {
          "command": "firmwareDownloader.openSerial",
          "when": "view == firmware-devices && viewItem == serial-device",
          "group": "inline"
        }
      ],
      "editor/context": [
        {
          "command": "firmwareDownloader.searchWithEverything",
          "group": "4_search@1",
          "when": "editorHasSelection"
        },
        {
          "command": "firmwareDownloader.toggleCppDefine",
          "group": "5_cpp@1",
          "when": "editorTextFocus && editorHasSelection"
        },
        {
          "command": "hermesRemote.sendSelectionToContext",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "hermesRemote.addFileToContext",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "firmwareDownloader.openLogViewer",
          "when": "resourceExtname == .txt || resourceExtname == .log || resourceExtname == .jsonl",
          "group": "2_workspace@5"
        },
        {
          "command": "hermesRemote.addFileToContext",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "firmwareDownloader.toggleCppDefine",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "hermesRemote.addFileToContext",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "editorFocus"
      },
      {
        "command": "hermesRemote.sendSelectionToContext",
        "key": "ctrl+shift+,",
        "mac": "cmd+shift+,",
        "when": "editorHasSelection"
      }
    ],
    "configuration": [
      {
        "title": "Quick Dove",
        "properties": {
          "quickFirmwarePlus.language": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "en",
              "zh-cn"
            ],
            "enumDescriptions": [
              "%config.language.auto%",
              "%config.language.en%",
              "%config.language.zh-cn%"
            ],
            "description": "%config.language%"
          },
          "quickSerial.atCommandPaths": {
            "type": "array",
            "default": [],
            "description": "%config.atCommandPaths%",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          }
        }
      },
      {
        "title": "Hermes Remote",
        "properties": {
          "hermesRemote.terminalNamePatterns": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.hermes.terminalNamePatterns%"
          },
          "hermesRemote.remoteMappings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "local": {
                  "type": "string",
                  "description": "%config.hermes.remoteMappingLocal%"
                },
                "remote": {
                  "type": "string",
                  "description": "%config.hermes.remoteMappingRemote%"
                }
              },
              "required": [
                "local",
                "remote"
              ]
            },
            "default": [],
            "description": "%config.hermes.remoteMappings%"
          },
          "hermesRemote.useAbsolutePaths": {
            "type": "boolean",
            "default": false,
            "description": "%config.hermes.useAbsolutePaths%"
          },
          "hermesRemote.workspaceRoot": {
            "type": "string",
            "default": "",
            "description": "%config.hermes.workspaceRoot%"
          },
          "hermesRemote.pathStyle": {
            "type": "string",
            "enum": [
              "windows",
              "posix"
            ],
            "default": "windows",
            "description": "%config.hermes.pathStyle%"
          },
          "hermesRemote.pathPrefix": {
            "type": "string",
            "default": "windows",
            "description": "%config.hermes.pathPrefix%"
          }
        }
      }
    ]
  }
}
